{
  "name": "@zhz8888/dsh-ios-simulator-helper",
  "version": "1.1.2",
  "icon": "./ios-simulator.png",
  "description": "iOS Simulator management for DeepSeek Harness: Xcode project discovery and scaffolding, simulator boot/install/launch/terminate, screenshots, logs and optional idb UI automation, ported from the official ZCode ios-simulator plugin, with its parameter page on the plugin's own detail page in the Plugins panel and a macOS-only host check.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ios",
    "simulator",
    "simctl",
    "xcode",
    "macos"
  ],
  "license": "MIT",
  "author": {
    "name": "zhz8888"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhz8888/dsh-ios-simulator-helper.git"
  },
  "homepage": "https://github.com/zhz8888/dsh-ios-simulator-helper#readme",
  "bugs": {
    "url": "https://github.com/zhz8888/dsh-ios-simulator-helper/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "locale",
    "cordis.patch.yml",
    "ios-simulator.png",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "name": "ios-simulator-helper",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --test test/*.test.js && node scripts/check-bundle.mjs && node scripts/verify-mount.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:simulator": "node scripts/smoke.mjs --with-simulator",
    "verify:mount": "node scripts/verify-mount.mjs",
    "link:dsh-deps": "node scripts/link-dsh-deps.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2"
  },
  "packageManager": "pnpm@11.8.0"
}
