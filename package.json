{
  "name": "@zhz8888/dsh-ios-simulator-helper",
  "version": "1.0.0",
  "icon": "./ios.svg",
  "description": "iOS Simulator management for DeepSeek Harness: Xcode project discovery and scaffolding, simulator boot/install/launch/terminate, screenshots, logs and optional idb UI automation, ported from the official ZCode ios-simulator plugin, with a full in-app settings page and a macOS-only host check.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ios",
    "simulator",
    "simctl",
    "xcode",
    "macos"
  ],
  "license": "MIT",
  "author": {
    "name": "zhz8888"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhz8888/dsh-ios-simulator-helper.git"
  },
  "homepage": "https://github.com/zhz8888/dsh-ios-simulator-helper#readme",
  "bugs": {
    "url": "https://github.com/zhz8888/dsh-ios-simulator-helper/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "locale",
    "cordis.patch.yml",
    "ios.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "name": "ios-simulator-helper",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --test test/*.test.js && node scripts/check-bundle.mjs && node scripts/verify-mount.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:simulator": "node scripts/smoke.mjs --with-simulator",
    "verify:mount": "node scripts/verify-mount.mjs",
    "link:dsh-deps": "node scripts/link-dsh-deps.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4 || ^4.0.5-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.4 || ^3.18.5-alpha.1"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.8.0"
}
