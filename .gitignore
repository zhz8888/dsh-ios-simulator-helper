# dsh-ios-simulator-helper — things that must never be committed.
#
# The published package is defined by the `files` field in package.json, not by
# this file: everything below is development state, and test/manifest.test.js
# asserts that none of it can reach the tarball.

# --- dependencies ---------------------------------------------------------
node_modules/
# pnpm keeps a store next to the project when no global one is configured.
.pnpm-store/

# --- scratch directories --------------------------------------------------
# Smoke runs, throwaway DSH trial profiles and any other local scratch space.
.tmp-*/
.dsh-*/

# --- test and coverage output --------------------------------------------
coverage/
*.lcov
.nyc_output/

# --- packaging output -----------------------------------------------------
*.tgz
*.tar.gz

# --- test artifacts, logs and local captures ------------------------------
# What `pnpm test`, scripts/verify-mount.mjs and scripts/smoke.mjs produce —
# screenshots, build logs, DerivedData — is evidence, not source: it stays in
# the plugin data directory or in the throwaway project the smoke run creates.
# The durable record of a run belongs in the project memory, never here.
#
# `assets/` is the one exception, and it is not a capture directory: it holds
# the hand-picked screenshots that `screenshots.json` declares to a plugin
# market, so those files are tracked on purpose.
docs/verification/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
*.tmp
*.temp
.cache/
# A build's DerivedData tree. `ios_build_app` resolves `derivedDataPath`
# inside the session workspace and the `derivedDataDir` setting is resolved
# against it, so the tree lands in the checkout whenever the workspace is
# the repository.
DerivedData/
# A screenshot lands in the session workspace when the screenshot directory is
# configured to a workspace-relative one — the default writes under the plugin
# data directory instead. These are the two directories a run can put a capture
# in, named rather than covered by a blanket `*.png`: that rule ignored every
# PNG at every depth, so a future image the repository means to track would
# have been silently dropped by `git add`.
screenshots/
/*.png
# ...except the curated marketplace screenshots: `assets/` holds the four
# hand-picked frames `screenshots.json` declares to a plugin market.
!assets/*.png
# ...except the plugin icon: `package.json` names it and `dsh-app-boot` resolves
# it inside the manifest directory, so it has to sit at the package root.
!/ios-simulator.png

# --- editors and IDEs -----------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- operating systems ----------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100/
.Trashes
Thumbs.db
desktop.ini
